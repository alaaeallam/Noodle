<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="ie=edge" />
  <title>BTB Email</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lato&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">

  <style id="applicationStylesheet" type="text/css">

    body {
      font-family: 'Roboto', sans-serif !important;
      line-height: 1.6;
      margin: 0;
      padding: 0;
    }

    table {
      border-spacing: 0;
      width: 600px;
      margin: auto;
    }

    a {
      color: #052e16;
      display: inline-block;
      font-size: 14px;
      font-weight: 600;
      text-decoration: underline;
    }

    p {
      margin: 0;
    }
  </style>
</head>

<body>

  <table>
    <tbody>
      <!-- BTB nav -->
      <tr>
        <td style="font-size: 6px; line-height: 10px; padding: 12px 0px 12px 0px; text-align: center;" align="center">
          <img width="80" height="80" alt="BTB" src="https://foodapp-admin.alaaeallam.com/assets/images/png/btb-email-logo.png" />
        </td>
      </tr>

      <!-- BTB header -->
      <tr>
        <td>
          <table
            style="margin:auto; background: url('http://cdn.mcauto-images-production.sendgrid.net/c6db57d8e09f410b/c7ad3f09-094e-45a1-a35a-489b395a89a3/1200x270.png'); background-size: cover; background-position: center; background-repeat: no-repeat; width: 100%;">
            <tr>
              <td style="text-align: center; padding-top: 24px;">
                
                  <img
                    src="http://cdn.mcauto-images-production.sendgrid.net/c6db57d8e09f410b/f6174c4c-8a58-42fa-af86-1dd3d8c1c45e/80x81.png"
                    width="40">
              </td>
            </tr>
            <tr>
              <td style="font-family: 'Roboto', sans-serif; font-size: 26px; color: #18181b; font-weight: 800; text-align: center; padding:10px 0 20px 0;">
                Account Created!
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <!-- details section -->
      <tr>
        <td align="center">
          <table width="100%" align="center" border="0" style="max-width: 552px; height: 118px; margin-top: 19px;">
            <tr>
              <td align="center">
                <p
                  style="font-family: 'Roboto', sans-serif; color: #18181B; text-align: center; font-size: 14px; font-style: normal; font-weight: 600; margin: 2px 0px; text-transform: uppercase;">
                  Access Credentials</p>
              </td>
            </tr>
            <tr>
              <td align="center">
                <p
                  style="font-family: 'Roboto', sans-serif; color: #18181B; text-align: center; font-size: 16px; font-style: normal; font-weight: 400; margin: 2px 0px;">
                  Your authentication details are provided below.</p>
              </td>
            </tr>
            <tr>
              <td align="center">
                <table height='118px' border="0" align="center" bgcolor='#F7F7F4'
                  style="width: 471px; border-radius: 12px; border: 1px solid rgba(26, 46, 5, 0.10); background: #F7F7F4; box-shadow: 0px 4px 8px 2px rgba(26, 46, 5, 0.06), inset 0 0 0 1px rgba(26, 46, 5, 0.10); margin: 19px;">
                  <tr>
                    <td
                      style="font-family: 'Roboto', sans-serif; color: #18181B; font-size: 16px; font-style: normal; font-weight: 400; line-height: normal; padding: 24px 15px 10px 24px; vertical-align: middle;">
                      
                      Username:
                    </td>
                    <td align="right"
                      style="font-family: 'Roboto', sans-serif; color: #18181B; font-size: 16px; font-style: normal; font-weight: 600; line-height: normal; text-align: right; padding: 24px 24px 10px 40px;">
                      <p style="font-family: 'Roboto', sans-serif;">
                        <%= params.name %>
                      </p>
                    </td>
                  </tr>
                  <tr>
                    <td colspan="2" style="padding: 0 24px;">
                      <hr>
                    </td>
                  </tr>
                  <tr>
                    <td
                      style="font-family: 'Roboto', sans-serif; color: #18181B; font-size: 16px; font-style: normal; font-weight: 400; line-height: normal; padding: 10px 15px 24px 24px; vertical-align: middle;">
                      
                      Password:
                    </td>
                    <td align="right"
                      style="font-family: 'Roboto', sans-serif; color: #18181B; font-size: 16px; font-style: normal; font-weight: 600; line-height: normal; padding: 10px 24px 24px 40px; text-align: right;">
                      <p style="font-family: 'Roboto', sans-serif;">
                        <%= params.password %>
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <!-- Footer -->
      <tr style="background: #052E16;">
        <td style="line-height:10px; padding:25px 0px 25px 0px;" align="center">
          <img class="max-width" style="text-decoration:none;" width="60" height="60" alt="BTB" src="https://foodapp-admin.alaaeallam.com/assets/images/png/btb-email-logo.png">
        </td>
      </tr>
    </tbody>
  </table>

</body>


</html>

