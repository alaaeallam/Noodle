+// This module can end up evaluated more than once in a single JS context
+// when a monorepo/pnpm setup resolves more than one copy of react-native
+// (e.g. via distinct peer-dependency-driven pnpm store paths). The original
+// unconditional defineProperty crashes on the second evaluation since the
+// property is non-configurable; guard it so re-evaluation is a no-op instead.
+if (
+  Object.getOwnPropertyDescriptor(global, '__FUSEBOX_REACT_DEVTOOLS_DISPATCHER__') == null
+) {
+  Object.defineProperty(global, '__FUSEBOX_REACT_DEVTOOLS_DISPATCHER__', {
+    value: FuseboxReactDevToolsDispatcher,
+    configurable: false,
+    enumerable: false,
+    writable: false,
+  });
+}
